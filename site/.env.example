# Copy this file to .env and fill in real values. Never commit the real .env file.
# Every variable below was already required by the project except STAFF_TOKEN and
# DATA_DIR, which are new and optional — nothing existing was renamed or removed.

# --- Server ---
PORT=3000
NODE_ENV=development
# Public origin of this deployment, used to build the Roblox OAuth callback URL.
APP_ORIGIN=http://localhost:3000

# --- Sessions (required, 32+ random characters in production) ---
SESSION_SECRET=change-this-to-a-long-random-string

# --- Private/INR pricing login (single shared credential pair, not per-customer accounts) ---
INR_USERNAME=
INR_PASSWORD=

# --- Order/quote/support delivery (optional — blank means requests still validate
#     and get a reference ID, they just aren't delivered to Discord) ---
DISCORD_WEBHOOK_URL=

# --- Roblox OAuth (required for the "Connect with Roblox" step) ---
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=

# --- NEW: internal staff tooling ---
# Bearer-style token internal staff use to call the /api/staff/* endpoints
# (list orders/tickets, update an order's status, resolve a support ticket).
# These endpoints are never called by the public site's own JavaScript — they
# exist purely for staff to operate against (a script, Postman, an internal
# tool), which is what keeps fulfillment tooling walled off from customers.
# Leave blank to disable staff endpoints entirely (they respond 401).
STAFF_TOKEN=

# --- NEW: where order/review/support-ticket JSON files are written ---
# Optional. Defaults to ./data relative to the project root. There is still no
# real database — this is the same "flat file" honesty the project already
# documented for local orders, just moved server-side so status tracking,
# order-verified reviews and support-ticket lookup are genuinely live instead
# of device-only.
DATA_DIR=./data
