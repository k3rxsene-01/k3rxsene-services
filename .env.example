# Keep this file safe: .env is ignored and is never served to browsers.
PORT=3000
INR_USERNAME=replace-with-admin-provided-username
INR_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters
DISCORD_WEBHOOK_URL=
# Roblox OAuth 2.0 app credentials from create.roblox.com/dashboard/credentials.
# The authorize/token/userinfo endpoints themselves are fixed Roblox URLs and are
# hardcoded in server.js — you only need to supply your app's own credentials here.
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
# Public URL of this app, used as the OAuth callback. Example: https://services.example.com
APP_ORIGIN=http://localhost:3000
